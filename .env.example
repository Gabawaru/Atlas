# Atlas MVP — copier vers .env (jamais committer de secrets réels)
# Aucune valeur ci-dessous n'est un secret de production.

# Postgres
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_only
POSTGRES_DB=atlas
# Migrate/seed : user atlas (souvent superuser Docker — contourne RLS).
DATABASE_URL=postgresql://atlas:atlas_dev_only@localhost:5432/atlas?schema=public&options=-c%20app.bypass_rls%3Don
# Runtime / tests RLS : user atlas_app (NOSUPERUSER, créé par migration) — RLS s'applique.
# DATABASE_URL=postgresql://atlas_app:atlas_dev_only@localhost:5432/atlas?schema=public&options=-c%20app.bypass_rls%3Don
ATLAS_RLS_DATABASE_URL=postgresql://atlas_app:atlas_dev_only@localhost:5432/atlas?schema=public

# Redis (BullMQ — file d'exécution des contrôles)
REDIS_URL=redis://localhost:6379

# true = mocks réseau (CI offline) ; false/absent = preuves DNS/HTTP réelles sur cibles du scope
ATLAS_FORCE_MOCK_NETWORK=false


# API
API_PORT=3001
# Requis hors ATLAS_ENV=development|ci|test — le défaut ci-dessous est refusé en prod.
JWT_SECRET=dev-only-change-me-not-a-real-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Apps
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Marqueur environnement (development|ci|test autorisent le JWT_SECRET d'exemple)
ATLAS_ENV=development
ATLAS_SYNTHETIC_DEMO=true

# Déploiement — hosted | hybrid | local (ADR-009)
ATLAS_DEPLOY_MODE=hosted
# true = offline / partition (pas de fausse révocation distante instantanée)
ATLAS_OFFLINE=false

# Rétention (hypothèses RGPD — pas une certification) — jours
# ATLAS_TTL_AUDIT_DAYS=365
# ATLAS_TTL_REPORTS_DAYS=365
# ATLAS_TTL_ARTEFACTS_DAYS=365
# ATLAS_TTL_PII_DAYS=180
# ATLAS_TTL_LLM_DAYS=90
# Limitation de finalité (SignatureProvider.sign allowlist chat|mission) — défaut true
# ATLAS_PURPOSE_ENFORCE=true

# Assistant LLM — mock par défaut ; API optionnelle (secrets hors git)
# ATLAS_LLM_PROVIDER=mock|api
ATLAS_LLM_PROVIDER=mock
# ATLAS_LLM_API_URL=https://api.openai.com/v1/chat/completions
# ATLAS_LLM_API_KEY=  # ne jamais committer
# ATLAS_LLM_MODEL=gpt-4o-mini
# ATLAS_LLM_EURO_CENTS_PER_1M_TOKENS=50

# Gate chat : SignatureProvider.sign stub (sans PRAGMA_SIGN_API_KEY).
# Défaut runtime = pending (bloque POST /v1/conversation).
# Démo / smoke / CI : signed. Valeurs : signed | pending | rejected
# ATLAS_CHAT_SIGNATURE_STUB=pending
ATLAS_CHAT_SIGNATURE_STUB=signed

# Pragma Sign — signed-authz réel (jamais committer la clé).
# Si défini : SignatureProvider = Pragma Sign ; le gate poll l'enveloppe (status signed).
# PRAGMA_SIGN_API_KEY=
# ATLAS_PRAGMA_SIGNER_EMAIL=ben@pragma.mc
# ATLAS_PRAGMA_SIGNER_NAME=Autorité Pragma

# Signed-authz local/dev UNIQUEMENT si PRAGMA_SIGN_API_KEY absent.
# Avec clé : poll Sign API (pas ce flag). Absent ≠ signed → OWNER_AUTH_STUB.
# ATLAS_AUTHZ=signed

