# Atlas — template for a personal Windows PC (remote-work pack)
# Copy to repo-root `.env` (never commit real values).
# No production secrets below — paste keys locally only.

# Postgres / Redis (local docker-compose defaults are fine for smoke)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=
POSTGRES_DB=atlas
DATABASE_URL=
ATLAS_RLS_DATABASE_URL=
REDIS_URL=redis://localhost:6379

ATLAS_FORCE_MOCK_NETWORK=false

# API
API_PORT=3001
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Apps
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

ATLAS_ENV=development
ATLAS_SYNTHETIC_DEMO=true
ATLAS_DEPLOY_MODE=hosted
ATLAS_OFFLINE=false

ATLAS_LLM_PROVIDER=mock
ATLAS_CHAT_SIGNATURE_STUB=signed

# Secrets — paste ONLY in local .env (never chat / Slack / git)
PRAGMA_SIGN_API_KEY=
RESEND_API_KEY=

# Optional
# ATLAS_MAIL_OPS_TO=
# ATLAS_PRAGMA_SIGNER_EMAIL=
# ATLAS_PRAGMA_SIGNER_NAME=
