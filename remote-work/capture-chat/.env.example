# Shared bearer token — set the same value on server and Windows client. Never commit real values.
# Used by capture-chat.exe and optional API clients (Authorization: Bearer …).
CAPTURE_CHAT_TOKEN=change-me

# HMAC secret for email session cookies (defaults to CAPTURE_CHAT_TOKEN if unset).
# CAPTURE_CHAT_SESSION_SECRET=

# Email gate (web UI): allow *@DOMAIN plus explicit extras.
CAPTURE_CHAT_ALLOWED_DOMAIN=atlas-secu.com
# Comma-separated extras (optional). Defaults always include gabriel@ and ops@ atlas-secu.com.
# CAPTURE_CHAT_ALLOWED_EMAILS=

# Listen port (default 8787)
PORT=8787

# Set COOKIE_SECURE=0 for plain http://127.0.0.1 local smoke (HTTPS hosts keep default Secure cookies).
# COOKIE_SECURE=0

# Optional absolute data root (default: ./data next to this package)
# DATA_DIR=
