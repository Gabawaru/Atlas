// Atlas MVP — modèle aligné docs/modele-donnees.md
// Abonnement ≠ autorisation ; approbation A ≠ autorisation propriétaire.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  tenants   Tenant[]
  staff     StaffMembership[]
  groups    StaffGroup[]
}

model Tenant {
  id             String   @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  slug           String   @unique
  name           String
  status         String   @default("active")
  syntheticDemo  Boolean  @default(false)
  /// Hold légal : bloque toute purge automatique (hypothèse process, pas un avis juridique)
  legalHold      Boolean  @default(false)
  legalHoldReason String?
  legalHoldAt    DateTime?
  createdAt      DateTime @default(now())
  memberships    TenantMembership[]
  subscriptions  Subscription[]
  assets         Asset[]
  missions       Mission[]
  secretRefs     SecretRef[]
  auditEvents    AuditEvent[]
  routingPolicies ApprovalRoutingPolicy[]
  connectorGrants ConnectorGrant[]
  supportTickets SupportTicket[]
  softwareComponents SoftwareComponent[]
  llmUsageLogs   LlmUsageLog[]
  syncJournal    SyncJournalEntry[]
  purgeRuns      PurgeRun[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  tenantMemberships TenantMembership[]
  staffMemberships  StaffMembership[]
}

model TenantMembership {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  role     String // owner | operator | viewer
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
}

model StaffMembership {
  id        String @id @default(cuid())
  orgId     String
  userId    String
  staffRole String // admin | support | billing | ops | approver
  org       Organization @relation(fields: [orgId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId, staffRole])
}

model StaffGroup {
  id        String @id @default(cuid())
  orgId     String
  name      String
  /// Contenu fictif / stub — ne représente PAS la hiérarchie réelle A
  isStub    Boolean @default(true)
  memberIds String[] @default([])
  org       Organization @relation(fields: [orgId], references: [id])
  policies  ApprovalRoutingPolicy[]
}

model Plan {
  id               String @id @default(cuid())
  code             String @unique
  name             String
  modulesEntitled  String[]
  maxUsers         Int    @default(10)
  /// Plafond tokens LLM / mois calendaire (assistant) — 0 = illimité démo (à éviter en prod)
  llmTokenCapMonthly     Int @default(200000)
  /// Plafond € estimés en centimes / mois (assistant)
  llmEuroCapCentsMonthly Int @default(500)
  subscriptions    Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  planId    String
  status    String   // trialing | active | past_due | canceled
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
  payments  PaymentStub[]
}

/// Stub paiement — jamais un charge PSP réel (Stripe/Adyen…). Hors chemin Policy Guard.
model PaymentStub {
  id             String   @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String   @default("EUR")
  /// stub_recorded | simulated_success | simulated_failure
  status         String
  /// Toujours "stub" en MVP — pas de provider réel
  provider       String   @default("stub")
  externalRef    String?
  note           String?
  createdAt      DateTime @default(now())
  createdByUserId String?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Asset {
  id           String   @id @default(cuid())
  tenantId     String
  type         String   // domain | url | host
  value        String
  normalized   String
  verified     Boolean  @default(false)
  /// FICTIF — données de démonstration
  synthetic    Boolean  @default(false)
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, normalized])
}

model SecretRef {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String   @default("stub")
  path      String
  purpose   String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

/// Instance de connecteur (permissions révocables) — jamais de secret en clair
model ConnectorGrant {
  id                 String    @id @default(cuid())
  tenantId           String
  connectorId        String
  status             String    @default("active") // active | revoked
  grantedPermissions String[]
  grantedScopes      String[]
  /// Réf mock OAuth / lease — pas un access token GitHub réel
  externalRef        String?
  /// true = stub non production (ex. GitHub read-only mock)
  isStub             Boolean   @default(false)
  /// true = connecteur de contrôle réellement utilisable en MVP
  productionReady    Boolean   @default(false)
  connectedAt        DateTime  @default(now())
  revokedAt          DateTime?
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, connectorId, status])
}

model Mission {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  status          String   @default("DRAFT")
  blockedReason   String?
  /// true = démo fictive (A_SKIPPED_DEMO possible)
  synthetic       Boolean  @default(false)
  isRealMission   Boolean  @default(true)
  uxNeedIds       String[] @default([])
  moduleIds       String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  scopeVersions   ScopeVersion[]
  ownerAuths      OwnerAuthorization[]
  approvalReqs    ApprovalRequest[]
  tokens          AuthorizationToken[]
  jobRuns         JobRun[]
  findings        Finding[]
  reports         Report[]
  supportTickets  SupportTicket[]
  softwareComponents SoftwareComponent[]
}

model ScopeVersion {
  id           String   @id @default(cuid())
  missionId    String
  version      Int
  assetIds     String[]
  methods      String[]
  /// Hôtes/FQDN exclus du périmètre (RoE machine-readable)
  exclusions   String[] @default([])
  notes        String?
  periodStart  DateTime
  periodEnd    DateTime
  scopeHash    String
  immutable    Boolean  @default(true)
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  mission      Mission  @relation(fields: [missionId], references: [id])

  @@unique([missionId, version])
  @@index([scopeHash])
}

model OwnerAuthorization {
  id                   String   @id @default(cuid())
  missionId            String
  scopeVersionId       String
  scopeHash            String
  status               String   // valid | revoked | pending
  signerLabel          String
  /// Contrepartie A (2e partie du circuit mock)
  counterpartyLabel    String?
  counterpartyEmail    String?
  ownerSignedAt        DateTime?
  counterpartySignedAt DateTime?
  signatureArtifactRef String?
  /// Stub / mock — PAS une signature eIDAS réelle
  isStubSignature      Boolean  @default(true)
  signatureProvider    String?
  signatureEnvelopeId  String?
  signatureStatus      String?
  revokedAt            DateTime?
  createdAt            DateTime @default(now())
  mission              Mission  @relation(fields: [missionId], references: [id])
}

model ApprovalRoutingPolicy {
  id            String  @id @default(cuid())
  tenantId      String?
  orgWide       Boolean @default(false)
  modulePattern String  @default("*")
  staffGroupId  String?
  enabled       Boolean @default(true)
  /// Stub hiérarchie — ne pas présenter comme organigramme réel
  isStub        Boolean @default(true)
  tenant        Tenant? @relation(fields: [tenantId], references: [id])
  staffGroup    StaffGroup? @relation(fields: [staffGroupId], references: [id])
}

model ApprovalRequest {
  id                   String   @id @default(cuid())
  missionId            String
  scopeVersionId       String
  scopeHash            String
  ownerAuthorizationId String
  status               String   // pending | blocked_no_route | approved | rejected | returned
  createdAt            DateTime @default(now())
  mission              Mission  @relation(fields: [missionId], references: [id])
  decisions            ApprovalDecision[]
}

model ApprovalDecision {
  id              String   @id @default(cuid())
  requestId       String
  decision        String   // approved | rejected | returned
  approverUserId  String
  scopeHash       String
  comment         String?
  createdAt       DateTime @default(now())
  request         ApprovalRequest @relation(fields: [requestId], references: [id])
}

model AuthorizationToken {
  id         String   @id @default(cuid())
  missionId  String
  scopeHash  String
  moduleIds  String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  issuedAt   DateTime @default(now())
  mission    Mission  @relation(fields: [missionId], references: [id])
}

model JobRun {
  id                    String   @id @default(cuid())
  missionId             String
  tenantId              String
  moduleId              String
  authorizationTokenId  String?
  scopeHash             String
  status                String
  gateDecision          String?
  gateCode              String?
  gateReason            String?
  cancelRequested       Boolean  @default(false)
  rateLimitPerMinute    Int      @default(30)
  progressPercent       Int      @default(0)
  progressMessage       String?
  bullJobId             String?
  killedAt              DateTime?
  deadLetteredAt        DateTime?
  attemptCount          Int      @default(0)
  evidenceJson          Json?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime @default(now())
  mission               Mission  @relation(fields: [missionId], references: [id])
}

model Finding {
  id          String   @id @default(cuid())
  missionId   String
  jobRunId    String?
  severity    String
  title       String
  summary     String
  technical   String?
  /// FICTIF
  synthetic   Boolean  @default(true)
  /// Suivi corrections client : open | in_progress | fixed | accepted_risk | wont_fix | retest_requested
  remediationStatus String @default("open")
  remediationNote   String?
  remediatedAt      DateTime?
  /// Confiance du matching version→CVE — indépendante de severity (CVSS/gravité)
  /// low | medium | high | null (finding non issu d'un feed)
  confidence    String?
  cveId         String?
  kevListed     Boolean  @default(false)
  /// Sources : osv | nvd | kev (fixtures ou live)
  feedSources   String[] @default([])
  matchDisclaimer String?
  createdAt   DateTime @default(now())
  mission     Mission  @relation(fields: [missionId], references: [id])

  @@index([cveId])
}

/// Inventaire logiciel passif (seed FICTIF ou bannières HTTP observées) — pas de scan agressif
model SoftwareComponent {
  id            String   @id @default(cuid())
  tenantId      String
  missionId     String?
  /// Nom produit / package (ex. openssl, nginx)
  name          String
  version       String
  /// Ecosystem hint : openssl | nginx | npm | pypi | generic
  ecosystem     String   @default("generic")
  /// seed | http_server | manual
  observedFrom  String   @default("seed")
  synthetic     Boolean  @default(true)
  rawEvidence   String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  mission       Mission? @relation(fields: [missionId], references: [id])

  @@index([tenantId, name])
}

/// Cache local des feeds vulnérabilités (OSV / NVD / KEV)
model VulnFeedCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  source    String
  body      Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([source, expiresAt])
}

/// Tickets SAV / incidents staff A — support ≠ approbation
model SupportTicket {
  id               String   @id @default(cuid())
  tenantId         String
  missionId        String?
  subject          String
  body             String
  /// open | waiting | resolved | closed
  status           String   @default("open")
  /// incident | question | access | other
  category         String   @default("question")
  createdByUserId  String
  assigneeUserId   String?
  /// FICTIF
  synthetic        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  mission          Mission? @relation(fields: [missionId], references: [id])

  @@index([tenantId, status])
  @@index([status])
}

model Report {
  id                      String   @id @default(cuid())
  missionId               String
  executiveSummary        String
  technicalDetail         String
  /// FICTIF — exemple de rapport
  synthetic               Boolean  @default(true)
  exportJson              Json?
  exportCsv               String?
  exportPdfPath           String?
  exportsMarkedSynthetic  Boolean  @default(true)
  createdAt               DateTime @default(now())
  mission                 Mission  @relation(fields: [missionId], references: [id])
}

/// Historique des jobs de purge (rétention) — dry-run ou réel
model PurgeRun {
  id            String   @id @default(cuid())
  tenantId      String?
  dryRun        Boolean  @default(true)
  /// true si aucune suppression à cause d'un legal hold
  heldSkipped   Boolean  @default(false)
  categories    String[]
  deletedCounts Json
  notes         String?
  actorId       String?
  createdAt     DateTime @default(now())
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// File de sync contrôle plane (révocation / journaux) — drain au retour online
model SyncJournalEntry {
  id        String   @id @default(cuid())
  tenantId  String
  /// revoke_token | revoke_connector | audit_export | custom
  kind      String
  payload   Json
  /// pending | synced | failed
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())
  syncedAt  DateTime?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([status, createdAt])
}

/// Journal d'usage LLM — métadonnées seulement (pas de prompt/réponse complets)
model LlmUsageLog {
  id                 String   @id @default(cuid())
  tenantId           String
  actorId            String?
  provider           String   // mock | api
  model              String?
  /// Tokens estimés (prompt+completion) — jamais le contenu
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  estimatedEuroCents Int      @default(0)
  intent             String?
  /// Hash tronqué du message (pas le texte)
  messageFingerprint String?
  messageChars       Int      @default(0)
  /// Toujours false — l'assistant n'exécute pas
  executed           Boolean  @default(false)
  capped             Boolean  @default(false)
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

/// Append-only : pas de update/delete applicatif
model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  payload    Json?
  prevHash   String?
  hash       String
  requestId  String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([createdAt])
}
