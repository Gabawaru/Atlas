{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "start:nest": "nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:acceptance",
    "test:unit": "node --import tsx --test --test-timeout=20000 src/**/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/**/*.test.ts",
    "test:acceptance": "node --import tsx --test --test-timeout=30000 test/acceptance/**/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "echo 'ok'"
  },
  "dependencies": {
    "@atlas/policy-guard": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
