{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.1.0",
  "identifier": "local.atlas.client.stub",
  "build": {
    "beforeDevCommand": "pnpm --filter @atlas/client run dev",
    "devUrl": "http://localhost:3002",
    "beforeBuildCommand": "pnpm --filter @atlas/client run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas (stub desktop)",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001 http://127.0.0.1:3001"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
