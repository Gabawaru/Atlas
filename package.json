{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas — assistant de pentest autorisé (MVP)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel --filter @atlas/api --filter @atlas/admin --filter @atlas/client run dev",
    "dev:api": "pnpm --filter @atlas/api run dev",
    "dev:admin": "pnpm --filter @atlas/admin run dev",
    "dev:client": "pnpm --filter @atlas/client run dev",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @atlas/shared run test && pnpm --filter @atlas/policy-guard run test && pnpm --filter @atlas/risk-table run test && pnpm --filter @atlas/api run test:unit && pnpm --filter @atlas/client run test",
    "test:e2e": "pnpm --filter @atlas/api run test:e2e",
    "test:acceptance": "pnpm --filter @atlas/api run test:acceptance",
    "db:migrate": "pnpm --filter @atlas/api run db:migrate",
    "db:seed": "pnpm --filter @atlas/api run db:seed",
    "db:generate": "pnpm --filter @atlas/api run db:generate",
    "lint": "pnpm -r run lint --if-present",
    "smoke": "pnpm --filter @atlas/api run smoke",
    "demo:smoke": "bash apps/api/scripts/demo-smoke.sh",
    "client:smoke": "bash scripts/client-smoke.sh",
    "check:no-stage": "bash scripts/check-no-stage-personal.sh",
    "make-secure": "bash scripts/make-secure.sh",
    "client:stub-desktop": "cargo run --manifest-path apps/client/src-tauri/Cargo.toml",
    "atlas:shell": "bash scripts/unix/run-atlas-shell.sh",
    "atlas:build-shell": "bash remote-work/atlas-v1/build.sh",
    "docs:exemple-rapport": "pnpm --filter @atlas/api exec tsx scripts/generate-exemple-rapport.ts",
    "security:zap-dev": "bash scripts/security/zap-baseline-dev.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "body-parser": "^1.20.9"
    }
  }
}
